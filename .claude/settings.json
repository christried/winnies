{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": false
  },
  "permissions": {
    "allow": [
      "Bash(node scripts/branch-prune.mjs)",
      "Bash(node scripts/branch-prune.mjs --dry-run)"
    ],
    "deny": [
      "mcp__claude_ai_Vercel__web_fetch_vercel_url",
      "mcp__claude_ai_Vercel__get_access_to_vercel_url",
      "mcp__Vercel__web_fetch_vercel_url",
      "mcp__Vercel__get_access_to_vercel_url"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*[Gg]it[Hh]ub.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/attribution.mjs tool",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/attribution.mjs tool",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/machine-guard.mjs tool",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
