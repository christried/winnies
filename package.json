{
  "name": "winnies",
  "type": "module",
  "version": "0.9.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tests/tsconfig.json && tsc -p .storybook/tsconfig.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "favicons:stage": "node scripts/favicon-stage.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:build": "vitest run -c vitest.build.config.ts",
    "test:e2e": "playwright test",
    "test:db:up": "podman compose -f compose.test.yaml up -d",
    "test:db:down": "podman compose -f compose.test.yaml down -v"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@formkit/drag-and-drop": "^0.7.0",
    "@neondatabase/serverless": "^1.2.0",
    "@nuxt/content": "3.16.2",
    "@pinia/nuxt": "1.0.3",
    "@tailwindcss/vite": "^4.3.5",
    "better-auth": "^1.7.18",
    "better-sqlite3": "^13.0.3",
    "canvas-confetti": "^1.9.4",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/tabler": "^1.2.43",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/vue3-vite": "^10.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.15.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "storybook": "^10.6.7",
    "typescript": "^6.0.3",
    "vite": "8.3.7",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
