# Copy to .env and fill in. Every variable here is required — the build fails otherwise
# Once vitest runs, make sure to copy to .env.test and fill in nonsense (that fits the validation)

# Postgres
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth signing secret, can generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Discord OAuth application credentials
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Do not rename
NUXT_PUBLIC_APP_URL="http://localhost:3000"
