# Copy to .env and fill in. Every variable here is required except TEST_DATABASE_URL: the build fails otherwise
# For the API tests, copy to .env.test and fill in the test values; `pnpm test:api` loads it

# Postgres
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth signing secret, can generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Discord OAuth application credentials
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Do not rename
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Test database (only the API tests read it; never set it anywhere else)
# `pnpm test:db:up` starts it; `pnpm test:api` empties it on every run
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/winnies_test"

# Simulates the staging build locally: the dev sign-in at /api/dev/sign-in is registered in `pnpm build` too,
# and Storybook is built and served at /storybook/.
# A Vercel build ignores it and goes by its branch, so no dashboard variable can turn production into staging.
# Never set it on Vercel or in CI. The API and e2e tests blank it for their build.
# WINNIES_STAGE=staging

# Path of a Chromium for `pnpm test:e2e` and `node scripts/shots.mjs` to start, instead of the one
# `pnpm exec playwright install chromium` downloads. Only a cloud session sets it, in its environment
# (docs/agents/cloud.md), not in `.env`: the helper reads the environment only.
# WINNIES_CHROMIUM=/opt/pw-browsers/chromium

# Vercel "Protection Bypass for Automation" secret of the project, so `node scripts/shots.mjs` gets through
# staging's Vercel login. A credential: never print it, never pass it as an argument. Only that script reads it,
# from the environment or from this file. `scripts/staging-wizard.sh` writes it into the main checkout's .env,
# and `.worktreeinclude` copies .env into every agent worktree. Commented out: the wizard tests for the line.
# VERCEL_AUTOMATION_BYPASS_SECRET=
