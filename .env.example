# Copy to .env and fill in. Every variable here is required — the build fails
# loudly and names the offender if one is missing or malformed.

# Postgres
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth signing secret — see WT-D01
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Discord OAuth application credentials — see WT-D01
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Public base URL of this deployment. Nuxt maps this onto runtimeConfig.public.appUrl
# automatically — the NUXT_PUBLIC_ prefix is what makes that override work at runtime,
# so do not rename it.
NUXT_PUBLIC_APP_URL="http://localhost:3000"
