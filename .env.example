# Copy to .env and fill in. Every variable here is required except TEST_DATABASE_URL: the build fails otherwise
# For the API tests, copy to .env.test and fill in the test values; `pnpm test:api` loads it

# Postgres
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# Better Auth signing secret, can generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Discord OAuth application credentials
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Do not rename
NUXT_PUBLIC_APP_URL="http://localhost:3000"

# Test database (only the API tests read it; never set it anywhere else)
# `pnpm test:db:up` starts it; `pnpm test:api` empties it on every run
TEST_DATABASE_URL="postgres://postgres:postgres@localhost:5432/winnies_test"
